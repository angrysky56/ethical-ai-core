# Ethical AI Core - Environment Configuration
# Copy this file to .env and fill in your values

# =============================================================================
# LLM Provider Selection
# =============================================================================
# Options: "openrouter", "ollama", "lmstudio", "openai"
#
# ⚠️  WARNING: Use LOCAL models (Ollama/LM Studio) for dataset generation!
# The red team prompts include adversarial content designed to stress-test
# ethical boundaries. Using cloud providers (OpenAI, OpenRouter, Anthropic)
# for this purpose may violate their Terms of Service and result in account
# suspension. Local models have no such restrictions.
#
LLM_PROVIDER=ollama

# =============================================================================
# OpenRouter (https://openrouter.ai)
# - Cost-effective access to many models
# =============================================================================
# OPENROUTER_API_KEY=your_openrouter_key_here
# OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
# OPENROUTER_MODEL=x-ai/grok-4.1-fast

# =============================================================================
# Ollama (Local - Free)
# - Run: ollama serve
# - Pull model: ollama pull llama3.1:8b gemma3
# =============================================================================
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=qwen3-vl

# =============================================================================
# LM Studio (Local - Free)
# - Start server in LM Studio UI
# =============================================================================
# LMSTUDIO_BASE_URL=http://localhost:1234/v1
# LMSTUDIO_MODEL=local-model

# =============================================================================
# OpenAI (Direct)
# =============================================================================
# OPENAI_API_KEY=your_openai_key_here
# OPENAI_BASE_URL=https://api.openai.com/v1
# OPENAI_MODEL=gpt-4o-mini

# =============================================================================
# Ethical AI Core Settings
# =============================================================================
ETHICAL_PRINCIPLES_PATH=core_principles.md

# Generation seed for reproducibility
# Leave empty for random seed based on timestamp
# Set a value to reproduce exact same generations
# GENERATION_SEED=12345

# LLM request timeout in seconds (per request, not total)
# Set higher for slow models, lower for faster generation
LLM_TIMEOUT=60

TTT_STEPS=5
TTT_LR=0.01
